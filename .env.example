# Copy to .env for local development (never commit .env).
# On Vercel set the same names under Project Settings -> Environment Variables.

# --- required in production -------------------------------------------------
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# PostgreSQL (e.g. Neon):  postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# MySQL:                   mysql://USER:PASSWORD@HOST:3306/DBNAME
# Leave empty locally to use SQLite.
DATABASE_URL=

# --- optional ---------------------------------------------------------------
DJANGO_DEBUG=True
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Only for a custom domain (the *.vercel.app domain is already allowed):
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Only if you open the pages from another origin than the API:
CORS_ALLOWED_ORIGINS=
