
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?original_path=/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/index?original_path=/admin/:path*"
    },
    {
      "source": "/interview/:path*",
      "destination": "/api/index?original_path=/interview/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/api/index?original_path=/static/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
